# Variables del panel. Copiar a `.env` y completar.
#
# Todas las NEXT_PUBLIC_* quedan horneadas en el JavaScript que descarga el
# navegador al compilar (`next build`): son públicas por definición. Nunca
# poner aquí un secreto. En producción viajan como `--build-arg` (ver
# Dockerfile y docker-compose.prod.yml del servidor).

# Obligatoria: URL de la API. En desarrollo, la de `npm run start:dev`.
NEXT_PUBLIC_API_URL=http://localhost:3100

# Mapas (Google Maps). La clave vigente solo acepta el dominio de producción:
# en localhost Google responde RefererNotAllowedMapError y los mapas muestran
# su aviso propio en lugar del mapa.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
